		{"id":"t2","type":"text","text":"NAS öncesi/sonrası planlanan metrikleri karşılaştır","x":680,"y":1350,"width":280,"height":90},
		{"id":"p0","type":"text","text":"Yapısal kanal/filtre budama (başlık korumalı: cls/reg/obj_preds)","x":0,"y":1650,"width":280,"height":90},
		{"id":"p1","type":"text","text":"torch pruning: oran taraması %10/20/30/40 → ≤ 1,0 puan kayıpla en yüksek oran","x":340,"y":1650,"width":280,"height":90},
